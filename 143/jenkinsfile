pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code'
                checkout scm
            }
        }

        stage('Check Workspace') {
            steps {
                bat 'echo Current directory:'
                bat 'cd'
                bat 'echo Files:'
                bat 'dir'
                bat 'echo Searching for pom.xml:'
                bat 'dir /s /b pom.xml'
            }
        }

        stage('Build') {
            steps {
                echo 'Building project'
                bat 'mvn -f 143/pom.xml clean compile'
            }
        }

        stage('Run Selenium Tests') {
            steps {
                echo 'Running Selenium tests'
                bat 'mvn -f 143/pom.xml test'
            }
        }
    }
}
